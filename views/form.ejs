<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>form input</title>
</head>
<body>
    <h2>Create New Post</h2>
    <form method="POST" action="/posts">
        <input placeholder="enter your username" name="username"><br><br>
        <textarea placeholder="write your post" name="content" rows="5" cols="50"></textarea><br>
        <button>Submit</button>
    </form>
</body>
</html>